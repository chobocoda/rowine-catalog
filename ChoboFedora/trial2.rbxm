								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GuiHandler</string>
								<ProtectedString name="Source">panel = script.Parent
player = game:GetService(&quot;Players&quot;).LocalPlayer
cmd = player.Character.ChoboFedora.ChoboFedoraHandler.CMD
panelTargetText = panel.Target.Text

-- MAIN VVVV
panel.Fling.MouseButton1Click:connect(function() cmd:FireServer(&quot;fling&quot;, panelTargetText, nil) end)
panel.God.MouseButton1Click:connect(function() cmd:FireServer(&quot;god&quot;, panelTargetText, nil) end)
panel.Kill.MouseButton1Click:connect(function() cmd:FireServer(&quot;kill&quot;, panelTargetText, nil) end)
panel.TP1.MouseButton1Click:connect(function() cmd:FireServer(&quot;tp1&quot;, panelTargetText, nil) end)
panel.TP2.MouseButton1Click:connect(function() cmd:FireServer(&quot;tp2&quot;, panelTargetText, nil) end)


-- SOUNDBOARD VVVV
panel.Soundboard.BC.MouseButton1Click:connect(function() cmd:FireServer(&quot;sndboard&quot;, &quot;play&quot;, panel.Soundboard.BC.ID.Value) end)
