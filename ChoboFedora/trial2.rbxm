				<string name="Name">ChoboFedoraHandler</string>
				<ProtectedString name="Source">--[[
&#9;
&#9;ChoboFedoraHandler by CyberChobo&#9;
&#9;Version: 0.1 - 16/11/26&#9;
&#9;
--]]

wait(1) -- CHOBO: prevent race conditions

-- VARIABLES VVVV
hatParent = script.Parent
charParent = script.Parent.Parent
player = game:GetService(&quot;Players&quot;):GetPlayerFromCharacter(charParent)
&#9;
hasPermission = false


-- SETTINGS VVVV
needsPermission = false -- CHOBO: Turn OFF during testing, turn ON for upload


-- FUNCTIONS VVVV
function init()
&#9;script.Fire:Clone().Parent = charParent:FindFirstChild(&quot;Left Arm&quot;)
&#9;script.Fire:Clone().Parent = charParent:FindFirstChild(&quot;Right Arm&quot;)
&#9;
&#9;script.ChoboGui:Clone().Parent = player.PlayerGui
end

function cmd(playerSender, data1, data2, data3)
&#9;if (playerSender.userId == 7) or (needsPermission == false) then -- CHOBO: CyberChobo
&#9;&#9;if (data1 == &quot;kill&quot;) then
&#9;&#9;&#9;game:GetService(&quot;Players&quot;)[data2].Character.Torso:Destroy()
&#9;&#9;elseif (data1 == &quot;fling&quot;) then
&#9;&#9;&#9;script.BodyThrust:Clone().Parent = game:GetService(&quot;Players&quot;)[data2].Character.Torso
&#9;&#9;elseif (data1 == &quot;tp1&quot;) then
&#9;&#9;&#9;charParent.HumanoidRootPart.CFrame = game:GetService(&quot;Players&quot;)[data2].Character.HumanoidRootPart.CFrame
&#9;&#9;elseif (data1 == &quot;tp2&quot;) then
&#9;&#9;&#9;game:GetService(&quot;Players&quot;)[data2].Character.HumanoidRootPart.CFrame = charParent.HumanoidRootPart.CFrame
&#9;&#9;elseif (data1 == &quot;god&quot;) then
&#9;&#9;&#9;game:GetService(&quot;Players&quot;)[data2].Character.Humanoid.MaxHealth = 99999999
&#9;&#9;&#9;game:GetService(&quot;Players&quot;)[data2].Character.Humanoid.Health = 99999999
&#9;&#9;elseif (data1 == &quot;sndboard&quot;) then
&#9;&#9;&#9;if (data2 == &quot;play&quot;) then
&#9;&#9;&#9;&#9;snd = Instance.new(&quot;Sound&quot;)
&#9;&#9;&#9;&#9;snd.Parent = hatParent.Handle
&#9;&#9;&#9;&#9;snd.SoundId = &quot;https://www.rowine.lol/asset/?id=&quot;..data3
&#9;&#9;&#9;&#9;snd.Volume = 1
&#9;&#9;&#9;&#9;snd:Play()
&#9;&#9;&#9;elseif (data2 == &quot;stop&quot;) then
&#9;&#9;&#9;&#9;a = hatParent.Handle
&#9;&#9;&#9;&#9;for i = 1, #a do
&#9;&#9;&#9;&#9;&#9;if (a[i].ClassName == &quot;Sound&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;a[i]:Destroy()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;playerSender:Destroy() -- CHOBO: no
&#9;end
end

script.CMD.OnServerEvent:connect(function(playerSender, data1, data2, data3) 
&#9;cmd(playerSender, data1, data2, data3)
end)

-- ENTRYPOINT VVVV
if (player.userId == 7 ) or (needsPermission == false) then -- CHOBO: CyberChobo, idk if anyone else wants perms for this
&#9;init()
end</ProtectedString>
